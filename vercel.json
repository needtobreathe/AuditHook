{
  "buildCommand": "npm run build --workspace=packages/shared-types && npm run build --workspace=apps/web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://audithook.up.railway.app/api/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://audithook.up.railway.app/ingest/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
